<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="employee_resignation_tree" model="ir.ui.view">
            <field name="name">Resignation / Termination</field>
            <field name="model">hr.resignation</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <tree string="Employee Resignation">
                <field name="grade_code"/>
                    <field name="employee_id" />
                    <field name="department_id" />
                    <field name="employee_contract" />
                    <field name="joined_date" readonly="1" />
                    <field name="resign_confirm_date" string="Resignation Date"/>
                    <field name="expected_revealing_date" />
                    <field name="approved_revealing_date" />
                    <field name="resignation_type" />
                    <field name="notice_period" />
                    <field name="state" />
                </tree>
            </field>
        </record>
        <record id="employee_resignation_form" model="ir.ui.view">
            <field name="name">Resignation / Termination</field>
            <field name="model">hr.resignation</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <form string="Employee Resignation">
                    <header>
                        <button string="Submit" type="object" name="action_submit" states='draft' class="oe_highlight" />
                        <button string="Direct Manager Approve" type="object" name="direct_approve" states='direct_manager' class="oe_highlight"/>
                        <button string="Department Manager Approve" type="object" name="department_approve" states='dep_manager' class="oe_highlight"  />
                        <button string="HR Manager Approve" type="object" name="hr_approve" states='hr_manager' groups="hr.group_hr_manager" class="oe_highlight"/>
                        <button string="CEO Approve" type="object" name="ceo_approve" states='ceo' class="oe_highlight"/>
                        <button string="Reset to Draft" type="object" name="reset_to_draft" groups="hr.group_hr_user" states="cancel" class="btn-success"/>
                        <button string="Cancel" type="object" name="cancel_resignation" groups="hr.group_hr_user" class="btn-danger"/>
                        <field name="current_user" invisible="1"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,direct_manager,hr_manager,approved" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box" attrs="{'invisible': [('eos_id', '=', False)]}">
                            <button class="oe_stat_button" name="open_eos" type="object" icon="fa-archive" string="EOS">
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" />
                            </h1>
                        </div>
                        <group>
                            <group string="Employee Details">
                                <field name="read_only" invisible="1" />
                                <field name="employee_id"/>
                                <field name="job_id"/>
                                <field name="department_id" />
                                <field name="employee_contract" readonly="1"/>
                            </group>
                            <group string="Dates">
                                <field name="joined_date" readonly="1"/>
                                <field name="resign_confirm_date" readonly="1" attrs="{'invisible':[('resign_confirm_date','=',False)]}" />
                                <field name="expected_revealing_date" attrs="{'readonly': [('state','=','approved')]}" />
                                <field name="approved_revealing_date" groups="hr.group_hr_user" />
                                <field name="notice_period" />
                            </group>
                            <group string="Resignation Details">
                                <field name="requested_by" readonly="1" />
                                <field name="resignation_type" string="Type" groups="hr.group_hr_user" attrs="{'readonly': [('state','=','approved')]}" />
                                <field name="termination_type" attrs="{'required': [('resignation_type', '=', 'fired')],'invisible': [('resignation_type', '!=', 'fired')],'readonly': [('state','=','approved')]}" />
                                <field name="reason" attrs="{'readonly': [('state','=','approved')]}" />
                                <field name="eos_id" invisible="1" />

                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <!-- <field name="activity_ids" widget="mail_activity" /> -->
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="view_employee_resignation">
            <field name="name">Employee Resignation</field>
            <field name="res_model">hr.resignation</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_resignation_type': 'resigned'}</field>
            <field name="domain">[('resignation_type','=','resigned')]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Employee Resignation Form
                </p>
            </field>
        </record>
        <record model="ir.actions.act_window" id="view_employee_termination">
            <field name="name">Employee Termination</field>
            <field name="res_model">hr.resignation</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_resignation_type': 'fired'}</field>
            <field name="domain">[('resignation_type','=','fired')]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Employee Termination Form
                </p>
            </field>
        </record>
        <!-- <menuitem id="employee_resignation" name="Resignation/Termination" groups="base.group_user" web_icon="hr_resignation,static/description/resignation_web.png" sequence="21" />
        <menuitem id="employee_resignation_request" parent="employee_resignation" name="Resignation Request" action="view_employee_resignation" groups="base.group_user" sequence="4" />
        <menuitem id="employee_termination_request" parent="employee_resignation" name="Termination Request" action="view_employee_termination" groups="base.group_user" sequence="4" /> -->
    </data>
</odoo>